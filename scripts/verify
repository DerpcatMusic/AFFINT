#!/usr/bin/env python3
"""Run one coordinated AFFINT verification cycle under an exclusive process lock."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
from datetime import datetime, timezone


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--package", action="append", default=[])
    parser.add_argument("--build-app", action="store_true")
    parser.add_argument("--release", action="store_true")
    parser.add_argument("--jobs", type=int, default=4)
    parser.add_argument("--test-target")
    parser.add_argument("--test-filter")
    parser.add_argument("--nocapture", action="store_true")
    parser.add_argument("--label", required=True)
    args = parser.parse_args()
    if args.jobs < 1:
        parser.error("jobs must be positive")
    root = Path(__file__).resolve().parents[1]
    artifact = root / ".research" / "verification" / args.label
    artifact.mkdir(parents=True, exist_ok=True)
    with (root / ".affint-build.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Another AFFINT verification process owns the build lock.", file=sys.stderr)
            return 75
        env = os.environ.copy()
        env.setdefault("CARGO_TARGET_DIR", str(root / "target"))
        env.setdefault("CARGO_PROFILE_DEV_DEBUG", "0")
        selections = [part for package in args.package for part in ("-p", package)]
        scope = selections or ["--workspace"]
        profile = ["--release"] if args.release else []
        format_scope = selections or ["--all"]
        test_selection = ["--test", args.test_target] if args.test_target else []
        test_output = []
        if args.test_filter or args.nocapture:
            test_output = ["--"]
            if args.test_filter:
                test_output.append(args.test_filter)
            if args.nocapture:
                test_output.append("--nocapture")
        commands = [
            ["cargo", "fmt", *format_scope, "--", "--check"],
            ["cargo", "test", "--locked", *scope, *profile, *test_selection,
             "-j", str(args.jobs), *test_output],
            ["cargo", "clippy", "--locked", *scope, "--all-targets", *profile,
             "-j", str(args.jobs), "--", "-D", "warnings"],
        ]
        if args.build_app:
            commands.append(["cargo", "build", "--locked", "-p", "affint-app",
                             *profile, "-j", str(args.jobs)])
        record = {"label": args.label, "started": datetime.now(timezone.utc).isoformat(),
                  "pid": os.getpid(), "steps": []}
        for index, command in enumerate(commands):
            log_path = artifact / f"{index + 1:02d}-{command[1]}.log"
            print("Running:", " ".join(command), flush=True)
            with log_path.open("w") as log:
                result = subprocess.run(command, cwd=root, env=env, stdout=log,
                                        stderr=subprocess.STDOUT, check=False)
            record["steps"].append({"command": command, "exit_code": result.returncode,
                                    "log": str(log_path.relative_to(root))})
            (artifact / "result.json").write_text(json.dumps(record, indent=2) + "\n")
            if result.returncode:
                print(log_path.read_text(errors="replace")[-12000:], file=sys.stderr)
                return result.returncode
        record["finished"] = datetime.now(timezone.utc).isoformat()
        (artifact / "result.json").write_text(json.dumps(record, indent=2) + "\n")
        print("Verification passed; evidence:", artifact.relative_to(root))
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
